# ==============================================================================
# InsightHub Environment Variables Template (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. Do NOT put real secrets, secret keys, or passwords in this template file.
# 2. To configure your local environment, copy this file to `.env.local`
#    (which is ignored by Git in `.gitignore`).
# 3. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#    NEVER prefix AWS secret access keys with NEXT_PUBLIC_.
# ==============================================================================

# Application Configuration
PORT=3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="InsightHub"

# Future AWS Integration Placeholders (Optional until backend deployment)
# Set to 'true' only when AWS API Gateway is deployed and configured
NEXT_PUBLIC_ENABLE_AWS_BACKEND=false
# AWS_REGION=ap-south-1
# NEXT_PUBLIC_AWS_API_GATEWAY_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/dev
# S3_CSV_BUCKET_NAME=insighthub-csv-storage-placeholder
# DYNAMODB_DATASETS_TABLE=insighthub-datasets-placeholder
